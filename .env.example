# Copy to .env and fill in. Never commit .env.

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs. Check current IDs at https://ai.google.dev/gemini-api/docs/models
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# true = use recorded fixtures instead of calling Gemini (local development)
USE_FAKE_GEMINI=false

# Where generated images and book text are written
STORAGE_PATH=./data
